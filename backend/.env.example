# Copy to backend/.env and fill in. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://oopai:oopai@localhost:5432/oopai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1
REMEMBER_ME_REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30

# JSON list of allowed web origins (Expo web dev server)
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

RATE_LIMIT_ENABLED=true
# Failed logins per account (email and student ID count together) from one client IP, and per account overall.
# Per-IP is generous because campus networks share one address.
AUTH_RATE_LIMIT=10/minute
AUTH_ACCOUNT_RATE_LIMIT=100/hour
AUTH_IP_RATE_LIMIT=100/minute

# Deep link opened from the password reset email
PASSWORD_RESET_URL=oopai://reset-password

# SMTP for password reset emails. In development without SMTP, emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# AI exam generation. `fake` = offline generator for development/tests; production requires `gemini`.
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the primary model is overloaded, rate-limited or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
# Hard wall-clock limit per Gemini call (at least 1).
AI_TIMEOUT_SECONDS=300
AI_MAX_ATTEMPTS=3
EXAM_CREATE_RATE_LIMIT=10/minute
EXAM_DAILY_LIMIT=30

# Resume generations interrupted by a crash or restart.
GENERATION_RECOVERY_ENABLED=true
GENERATION_RECOVERY_INTERVAL_SECONDS=60
GENERATION_PENDING_GRACE_SECONDS=120
GENERATION_LEASE_SECONDS=900
GENERATION_MAX_RUNS=3
GENERATION_WORKERS=2
